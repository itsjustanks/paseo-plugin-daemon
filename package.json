{
  "name": "paseo-plugin-daemon",
  "description": "Daemon Link for Paseo: Hosts: private localhost links, reviewed Git project transfers, and project-scoped monitoring.",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjustanks/paseo-plugin-daemon.git"
  },
  "homepage": "https://github.com/itsjustanks/paseo-plugin-daemon#readme",

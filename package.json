    "@types/react-dom": "19.1.11",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@getpaseo/relay": "0.7.2",
    "ws": "8.21.3"
  }

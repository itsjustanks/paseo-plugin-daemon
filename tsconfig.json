{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "electron": [
        "./server/managed-browser/electron.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "tests/ui",
    "server/managed-browser/**/*.test.ts",
    "client/managed-browser/**/*.test.ts",
    "client/managed-browser/**/*.test.tsx",
    "shared/managed-browser/**/*.test.ts",
    "tests/managed-browser"
  ]
}
